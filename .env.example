# Copy to .env and export these (the app reads process.env; it has no .env loader on purpose).
NODE_ENV=production
HOST=0.0.0.0
PORT=4173
# Behind your own reverse proxy only (trusts X-Forwarded-For for rate limiting):
TRUST_PROXY=1
DB_PATH=/var/lib/openajar/openajar.db
SESSION_DAYS=30
# Deadline reminders: how many days ahead to remind, and a master on/off switch.
REMINDER_DAYS=7
REMINDERS_ENABLED=1
# Email via Resend (https://resend.com). Set these for real sending; without a key, emails are only shown at #/dev/inbox (dev).
APP_URL=https://your-domain.example
RESEND_API_KEY=
EMAIL_FROM=Open Ajar <hello@your-domain.example>
# Never seed fictional data in production unless you explicitly want to:
# SEED_DEMO=0
# DEMO_MODE=0

# EASIEST SETUP FOR LOCAL USE: create a file named .env in this folder with just:
#   RESEND_API_KEY=your_key_here
# then restart with `npm start`. (.env is git-ignored. Never paste the key into chat or commit it.)
