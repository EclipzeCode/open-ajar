# Copy to .env and fill in. Never commit .env.

# ---- Server ----
NODE_ENV=production
PORT=4000
# Comma-separated list of allowed dashboard origins (CORS). Leave empty to allow all (dev only).
CORS_ORIGINS=http://localhost:5173,https://dashboard.openajar.org

# ---- Database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/stray_to_stay?retryWrites=true&w=majority

# ---- Admin auth (the 4-founder panel) ----
# A long random secret. The dashboard sends it as:  Authorization: Bearer <ADMIN_API_TOKEN>
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=replace-with-a-long-random-string

# Public URL of the admin dashboard; used to build the "review" link in alert emails.
ADMIN_DASHBOARD_URL=https://dashboard.openajar.org

# ---- Alerting ----
# Score >= this triggers the co-founder email. Default 75.
ALERT_THRESHOLD=75
# Your 4 co-founder recipients (comma-separated).
COFOUNDER_EMAILS=founder1@example.com,founder2@example.com,founder3@example.com,founder4@example.com

# ---- Email (Nodemailer over SMTP) ----
# For SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=<your SendGrid API key>
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace-with-smtp-password-or-sendgrid-api-key
EMAIL_FROM=Open Ajar Alerts <alerts@openajar.org>
